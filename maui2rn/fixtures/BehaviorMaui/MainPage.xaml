<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:BehaviorMaui" x:DataType="vm:MainPageViewModel" Title="Customers">
  <VerticalStackLayout>
    <Entry Text="{Binding Query}" Placeholder="Search" />
    <Button Text="Open details" Command="{Binding OpenCommand}" />
    <CollectionView ItemsSource="{Binding Customers}" />
  </VerticalStackLayout>
</ContentPage>
