<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Customers">
  <VerticalStackLayout>
    <Label Text="Customer search" />
    <Entry Placeholder="Name" Text="{Binding Query}" />
    <Button Text="Search" Command="{Binding SearchCommand}" />
    <CollectionView ItemsSource="{Binding Customers}" />
  </VerticalStackLayout>
</ContentPage>
